# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Notebooks
.ipynb_checkpoints/

# Pipeline outputs (regenerate with scripts/run_pipeline.py)
out/
*/out/

# Credentials and secrets. Never commit Earth Engine or service-account keys.
.env
*.pem
*-credentials.json
service-account*.json
**/.config/earthengine/

# Real farmer plot boundaries and personal data: keep these out of git.
# The **/ prefix is load-bearing. A pattern containing a slash is anchored to
# this file's directory, so plain "data/real/" only covered Agro_Tech/data/real
# and left eudr-coffee-risk/data/real/ tracked, which is where the code actually
# writes. GPX too: a walked boundary is the same personal data as a GeoJSON.
**/data/real/
**/data/*_plots.geojson
*.gpx
!**/data/plots_sample.geojson

# Third-party tools downloaded for local use, not ours to vendor.
# The Whisp QGIS plugin (FAO, MIT) installs from inside QGIS via
# "Manage and install Plugins..." -> "Install from ZIP", not from this repo.
whisp_plugin/
*.zip

# OS noise
.DS_Store
Thumbs.db
HANDOFF.md
